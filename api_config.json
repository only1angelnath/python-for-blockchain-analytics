{
  "version": "1.0",
  "apis": {
    "defillama": {
      "requires_key": false,
      "base_url": "https://api.llama.fi"
    },
    "coingecko": {
      "requires_key": false,
      "base_url": "https://api.coingecko.com/api/v3"
    },
    "etherscan": {
      "requires_key": true,
      "key_env_var": "ETHERSCAN_API_KEY",
      "base_url": "https://api.etherscan.io/api"
    },
    "thegraph": {
      "requires_key": false,
      "base_url": "https://api.thegraph.com"
    }
  },
