    "polygon": [
      "https://rpc.ankr.com/polygon",
      "https://polygon.llamarpc.com"
    ],
    "arbitrum": [
      "https://rpc.ankr.com/arbitrum",
      "https://arbitrum.llamarpc.com"
    ],
    "base": [
      "https://rpc.ankr.com/base"
    ]
  }
}